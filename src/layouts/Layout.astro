---
import "../styles/common.css";
import { ClientRouter } from "astro:transitions";
---

<!DOCTYPE html>
<html lang="es">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <meta
        name="description"
        content={Astro.props.description ?? "Información nutricional de productos alimenticios"}
    >
    

    <!-- Configuración PWA -->
    <link rel="manifest" href="/manifest.json">

    <meta
    name="theme-color"
    content="#176B4D"
    >
    

    <title>{Astro.props.title ?? "Food Nutrition"}</title>

    <ClientRouter />

</head>

<body>

    <header
        class="header"
        transition:persist
    >

        <div class="container header-top">

            <div class="header-brand">

                <img
                    class="header-logo"
                    src="/image/logoFoodNutrition.png"
                    alt=""
                    width="56"
                    height="48"
                >

                <h1>Food Nutrition</h1>

                <p>
                    Información nutricional de productos alimenticios
                </p>

            </div>

            <div id="nav-container"></div>

        </div>

    </header>


    <slot />


    <script>
        import { initNav } from "../components/navComponent.js";

        document.addEventListener(
            "astro:page-load",
            initNav
        );
    </script>
    

<!-- Inicialización PWA -->
    <script is:inline src="/js/pwa-init.js"></script>

</body>

</html>
