---
import Layout from "../layouts/Layout.astro";

import "../styles/common.css";
import "../styles/contact.css";
---

<Layout title="Contacto - Food Nutrition">

    <main class="container">

        <section class="contact-section">

            <header class="section-header">

                <h2>
                    Contacto
                </h2>

                <p>
                    Datos del estudio de desarrollo.
                </p>

            </header>

            <div class="contact-grid">

                <article class="contact-card">

                    <h3>
                        Estudio de desarrollo
                    </h3>

                    <dl class="contact-details">

                        <div>
                            <dt>Nombre</dt>
                            <dd>Food Nutrition Dev Studio</dd>
                        </div>

                        <div>
                            <dt>Ubicación</dt>
                            <dd>La Plata, Buenos Aires, Argentina</dd>
                        </div>

                        <div>
                            <dt>Correo electrónico</dt>
                            <dd>
                                <a href="mailto:contacto@foodnutritionapp.dev">
                                    contacto@foodnutritionapp.dev
                                </a>
                            </dd>
                        </div>

                        <div>
                            <dt>Trabajo</dt>
                            <dd>
                                Trabajo Práctico Integrador -
                                Módulo 1 - Aplicaciones Móviles
                            </dd>
                        </div>

                    </dl>

                </article>

                <article class="contact-map-card">

                    <h3>
                        Nuestra oficina
                    </h3>

                    <p class="contact-map-address">
                        Catedral de La Plata, La Plata
                    </p>

                    <div class="contact-map-frame">

                        <iframe
                            title="Ubicación de la oficina - Catedral de La Plata"
                            src="https://www.google.com/maps?q=-34.9215,-57.9536&z=17&output=embed"
                            loading="lazy"
                            referrerpolicy="no-referrer-when-downgrade"
                        ></iframe>

                    </div>

                </article>

            </div>

        </section>

    </main>

    <footer class="footer">

        <div class="container">

            <p>
                Food Nutrition - Trabajo Práctico Integrador
            </p>

        </div>

    </footer>

    <script>
        import "../controllers/contactController.js";
    </script>

</Layout>